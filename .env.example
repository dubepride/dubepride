# ==========================================================================
# BIOBRIDGE — Biometric Time & Attendance Bridge environment configuration
# Copy to `.env.local` and adjust. Every value has a sensible default, so
# the app runs out of the box with the built-in ERP simulator.
# ==========================================================================

# ── Admin authentication (HR console) ──────────────────────────────────
# Master password for /login — the whole console is session-protected.
# CHANGE THIS in production. Defaults to "biobridge-admin" when unset.
ADMIN_PASSWORD=
# HMAC key for the signed session cookies. Any long random string.
# Defaults to a dev-only value when unset — set it before going live.
SESSION_SECRET=

# ── External ERP REST API ──────────────────────────────────────────────
# Leave ERP_API_URL empty to run against the built-in ERP simulator.
# Set it (and ERP_MOCK_MODE=false) to push real payloads to your ERP.
ERP_API_URL=
ERP_API_KEY=
ERP_MOCK_MODE=true

# Simulator only: simulate an ERP outage on every Nth batch to demonstrate
# offline buffering (records stay Pending until the ERP recovers). 0 = never.
ERP_MOCK_FAIL_EVERY=5

# ── Demo terminal simulator ───────────────────────────────────────────
# Simulates fingerprint terminals pushing punches so the dashboard is
# alive immediately. Set SIMULATOR_ENABLED=false in production (real
# devices push to /api/biometrics/push instead).
SIMULATOR_ENABLED=true
SIMULATOR_MIN_MS=2500
SIMULATOR_MAX_MS=5500
