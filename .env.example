# ==========================================================================
# BIOBRIDGE — Biometric Time & Attendance Bridge environment configuration
# Copy to `.env.local` and adjust. Every value has a sensible default, so
# the app runs out of the box with the built-in ERP simulator.
# ==========================================================================

# ── Admin authentication (HR console) ──────────────────────────────────
# /login authenticates against the seeded administrator account:
#   admin@biobridge.com / admin   (change it in Settings → Accounts).
# HMAC key for the signed session cookies. Any long random string.
# Defaults to a dev-only value when unset — set it before going live.
SESSION_SECRET=

# ── External ERP REST API ──────────────────────────────────────────────
# Leave ERP_API_URL empty to run against the built-in ERP simulator.
# Set it (and ERP_MOCK_MODE=false) to push real payloads to your ERP.
ERP_API_URL=
ERP_API_KEY=
ERP_MOCK_MODE=true

# Simulator only: simulate an ERP outage on every Nth batch to demonstrate
# offline buffering (records stay Pending until the ERP recovers). 0 = never.
ERP_MOCK_FAIL_EVERY=5

# ── Demo terminal simulator ───────────────────────────────────────────
# Simulates fingerprint terminals pushing punches so the dashboard is
# alive immediately. Set SIMULATOR_ENABLED=false in production (real
# devices push to /api/biometrics/push instead).
SIMULATOR_ENABLED=true
SIMULATOR_MIN_MS=2500
SIMULATOR_MAX_MS=5500

# -- First-run sample data ---------------------------------------------
# Demo roster (sample employees), sample terminals and a 6-day punch
# history. OFF by default: a live bridge must contain real people and real
# punches. Set to true only for a throwaway demo database.
SEED_DEMO_DATA=false

# ── Handsfree geofenced mobile clocking (Phase 15/16) ─────────────────
# Shared secret the mobile app sends as the `x-mobile-key` header to
# POST /api/attendance/geopunch and POST /api/mobile/login. Change this in
# production. Biometric terminals remain the primary channel; geofencing is
# opt-in per site.
MOBILE_PUNCH_KEY=
# Fallback PIN for the companion app's sign-in screen, used for any employee
# who has no personal PIN on file (Employees.Mobile_PIN). Defaults to "0000".
# Set per-employee PINs from an admin console rather than relying on this.
MOBILE_DEFAULT_PIN=

# ── Maps (browser geofencing UI + admin geofence editor) ────────────────
# Geoapify tile key (browser-exposed) for Leaflet map tiles. When unset the UI
# uses the DEMO OpenStreetMap tiles below; distances/verification remain
# server-side and correct regardless.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
# Optional Geoapify style (default: osm-bright)
NEXT_PUBLIC_MAP_TILE_STYLE=
# Optional override: full tile template, e.g. https://tiles.example/{z}/{x}/{y}.png?key={apiKey}
NEXT_PUBLIC_MAP_TILE_URL=
# Optional custom map attribution HTML (required for some custom providers)
NEXT_PUBLIC_MAP_ATTRIBUTION=
# DEMO TILE FALLBACK. Until a real key/template is set, maps render with the
# public OpenStreetMap standard tile server. OSM's tile usage policy forbids
# heavy/commercial use, so set this to `off` in production (the UI then shows
# an offline schematic instead) and add a keyed provider such as Geoapify.
NEXT_PUBLIC_MAP_DEMO_TILES=
# Optional maximum GPS accuracy (metres) before the geofence punch is rejected.
# 0 = disabled (default). Both geofence ingress routes respect this when set.
GEOFENCE_MAX_ACCURACY_METERS=

# ── Hosting / database (serverless deployments) ────────────────────────
# The app talks to SQLite through libSQL. Leave both TURSO_* vars EMPTY to run
# against a local file (data/ta-bridge.db, override with TA_DB_PATH) — the
# default for local dev, tests and an office PC.
#
# On a serverless host (Vercel / Netlify / Cloudflare Pages) function disks are
# ephemeral, so point at a remote Turso database instead. Create one free at
# https://turso.tech, then paste:
#   TURSO_DATABASE_URL=libsql://<your-db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token>
# The schema + demo seed run automatically on first use, exactly as locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional path to the local SQLite file (local mode only).
TA_DB_PATH=

# Shared secret for the scheduled ERP drain (/api/cron/erp-sync). Vercel Cron
# sends it automatically as `Authorization: Bearer <CRON_SECRET>`; an external
# scheduler (e.g. cron-job.org) can send the same header, or `x-cron-secret`,
# or `?secret=`. Generate a long random value. When unset the endpoint returns
# 503 rather than running unauthenticated.
CRON_SECRET=

# Force the app to treat this process as serverless (no in-process simulator /
# ERP retry loop). Detected automatically on Vercel/Netlify/Cloudflare/AWS
# Lambda/Azure Functions; set to 1 for any other short-lived host.
BIOBRIDGE_SERVERLESS=

# ── First-run seeded logins ────────────────────────────────────────────
# Seeding runs once on an empty database. The administrator is
# admin@biobridge.com / admin (change it in Settings → Accounts).
# Demo (non-admin) logins: "true" always seeds them, "false" never. Default is
# true on a normal host and false on a serverless host.
BIOBRIDGE_SEED_DEMO_ACCOUNTS=

