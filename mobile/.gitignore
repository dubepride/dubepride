# Expo / React Native
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native projects (continuous native generation — never edit by hand;
# run `npx expo prebuild` to regenerate).
android/
ios/

# Local build output
*.tsbuildinfo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.log

# Local env — EXPO_PUBLIC_* is inlined into the bundle, so this only holds
# deployment URLs/secrets and must never be committed.
.env
.env.local
.env.*.local
