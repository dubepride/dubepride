{
  "name": "mineazy-network",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first network discovery, topology visualisation, monitoring and troubleshooting console.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "collector": "node --import tsx src/collector/main.ts",
    "connect": "node scripts/connect-network.mjs",
    "demo:seed": "node --import tsx scripts/seed-demo.ts",
    "demo:scenario": "node --import tsx scripts/acceptance-scenario.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@xyflow/react": "^12.12.0",
    "net-snmp": "^3.29.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
