# =============================================================================
#  Mineazy Network — environment template
# =============================================================================
#
#  Copy this file to `.env` (or `.env.local`) and fill in what you need.
#  NOTHING in this file is a real secret. Every value below is either empty
#  or an obvious placeholder.
#
#  The console NEVER receives these values in the browser: they are read on
#  the server only. The one exception is the collector mode, which is also
#  editable in the Settings screen.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Where the data lives.
#
#   Local file (default)  — MINEAZY_DB_PATH=data/mineazy.db
#   Remote libSQL/Turso   — MINEAZY_DATABASE_URL=libsql://your-db.turso.io
#
# The file database is the recommended local-first setup. The remote URL is
# optional and uses the same SQL dialect.
MINEAZY_DB_PATH=data/mineazy.db

# Remote database (leave both empty for a local install).
# MINEAZY_DATABASE_URL=
# MINEAZY_DATABASE_TOKEN=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
#
# MINEAZY_SECRET_KEY encrypts the SNMP credentials at rest (AES-256-GCM).
#   • Set it to a long random string in production.
#   • If it is left empty, a per-install key is generated once and stored
#     next to the database file (mode 0600 on POSIX). That keeps local
#     installs working without shipping a secret, but a lost key file means
#     the stored credentials can no longer be decrypted.
#
# MINEAZY_SECRET_KEY_FILE overrides where that generated key is cached.
MINEAZY_SECRET_KEY=
MINEAZY_SECRET_KEY_FILE=data/secret.key

# MINEAZY_SESSION_SECRET signs the session cookie (HMAC-SHA256).
#   • Set it in production, otherwise sessions are signed with a built-in
#     development key that anyone can read in the source.
#   • Changing it signs every user out.
MINEAZY_SESSION_SECRET=

# -----------------------------------------------------------------------------
# First run
# -----------------------------------------------------------------------------
#
# The password of the `admin` account created on the very first start.
#   • Leave it empty and a ONE-TIME RANDOM password is printed to the console.
#   • Set it to choose your own. Minimum 8 characters.
MINEAZY_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Demo mode
# -----------------------------------------------------------------------------
#
# MINEAZY_DEMO=1 enables the labelled simulator and the demo controls.
#   • The simulated estate is flagged as SIMULATED everywhere it appears.
#   • It NEVER contacts real hardware.
#   • Leave it unset (or 0) in production.
MINEAZY_DEMO=0

# -----------------------------------------------------------------------------
# Collector
# -----------------------------------------------------------------------------
#
# MINEAZY_INLINE_COLLECTOR runs the collector inside the web server process.
#   • unset / 1  — enabled (the default in demo mode)
#   • 0         — disabled; run `npm run collector` as a separate process
#
# A single-writer lock (data/collector.lock) guarantees that the in-process
# collector and the standalone collector never write at the same time.
MINEAZY_INLINE_COLLECTOR=

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
#
# • The collector mode itself ("real", "simulated" or "off") is a SETTING,
#   stored in the database and editable in the Settings screen.
# • Poll intervals, thresholds, discovery rate limits and retention windows
#   are settings too — see docs/users-and-roles.md and the Settings screen.
# • Never commit a filled-in `.env` file to version control.
